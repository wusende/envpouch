{
  "name": "envpouch",
  "version": "0.3.0",
  "description": "Encrypted .env profiles: turn environment variables into password-protected files and run any command with them injected. Plaintext never touches disk, git or backups. Command: `envp`.",
  "license": "MIT",
  "author": "wusende",
  "homepage": "https://github.com/wusende/envpouch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wusende/envpouch.git"
  },
  "bugs": {
    "url": "https://github.com/wusende/envpouch/issues"
  },
  "keywords": [
    "env",
    "dotenv",
    "dotenvx-alternative",
    "sops-alternative",
    "secrets",
    "secrets-management",
    "encryption",
    "aes-256-gcm",
    "argon2",
    "cli",
    "environment-variables",
    "profile",
    "env-file",
    "security"
  ],
  "bin": {
    "envp": "bin/envp.js"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js"
  },
  "files": [
    "bin/",
    "vendor/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
